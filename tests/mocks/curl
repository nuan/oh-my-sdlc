#!/usr/bin/env bash
if [ -n "${MOCK_CURL_RESPONSE_FILE:-}" ]; then
  if [ ! -f "${MOCK_CURL_RESPONSE_FILE}" ]; then
    echo "ERROR: MOCK_CURL_RESPONSE_FILE not found: ${MOCK_CURL_RESPONSE_FILE}" >&2
    exit 1
  fi
  cat "${MOCK_CURL_RESPONSE_FILE}"
elif [ -n "${MOCK_CURL_RESPONSE:-}" ]; then
  echo "${MOCK_CURL_RESPONSE}"
else
  echo '{"object":"error","status":400,"message":"mock curl: no response configured"}' >&2
  exit 1
fi
exit "${MOCK_CURL_EXIT_CODE:-0}"
